<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="Artyom Eroshchenko, Yana Kaufman, Maria Kovaleva">
        <title>Coder/lab-2</title>

        <link href="/css/bootstrap.min.css" rel="stylesheet" type="text/css" crossorigin="anonymous">
    </head>
    <body style="width: 50vw;">
        <br/>
        <div class="input-group mb-1">
            <input id="text_len" class="form-control" aria-describedby="basic-addon3" type="number" value="<%= len %>"/>
            <button type="button" class="btn btn-primary" disabled>Text length</button>
        </div>
        <div class="input-group mb-3">
            <textarea id="gen_text" class="form-control" aria-label="Generated text" readonly><%= text %></textarea>
            <button id="btn_gentext" class="btn btn-primary">Generate text</button>
        </div>
        <a href="/">Home</a>
        <a href="/encode/">Encode</a>
        <a href="/decode/">Decode</a>
        <script src="/js/bootstrap.bundle.min.js"></script>
        <script>
            /**
             * Handles the "Generate Text" button click.
             * Sends a POST request to `/gentext/` with requested text length,
             * then updates the input and textarea with generated text.
             *
             * @param {Event} event - The click event object.
             */
            const handleGenerateText = event => {
                event.preventDefault();

                let l = Math.max(parseInt(document.querySelector("#text_len").value), 0);

                fetch("/gentext/", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(
                        {
                            "len": l
                        }
                    )
                })
                    .then((response) => {
                        response.json().then((json_response) => {
                            document.querySelector("#text_len").value = l;
                            document.querySelector("#gen_text").value = json_response.text;
                        })
                    })
                    .catch(error => alert(error));
            };

            // Initialize text length input with 0 if empty
            if(!(document.querySelector("#text_len").value)) document.querySelector("#text_len").value = 0;

            // Attach event listener to "Generate Text" button
            document.querySelector("#btn_gentext").addEventListener("click", handleGenerateText);
        </script>
    </body>
</html>