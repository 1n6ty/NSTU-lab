<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>App</title>
  </head>
  <body>
    <form action="" method="post">
        <input type="text" name="login" placeholder="Login" required value="<%= loginu %>"/>
        <input type="text" name="password" placeholder="Password" required value="<%= pass %>"/>
        <input type="text" name="lastname" placeholder="Lastname" value="<%= lastname %>"/>
        <input type="text" name="name" placeholder="Name" value="<%= nameu %>"/>
        <input type="text" name="patronymic" placeholder="Patronymic" value="<%= patronymic %>"/>
        <button type="submit">Submit</button>
    </form>
  </body>
</html>